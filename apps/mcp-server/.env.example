PORT=4000

# Shared secret for the /mcp endpoint. Set it whenever the server is reachable
# from the internet (e.g. through a tunnel for Alexa+), and configure the MCP
# client to send "Authorization: Bearer <value>". Leave empty for local use.
NEXUS_MCP_TOKEN=

# --- AWS -------------------------------------------------------------------
# Credentials come from the standard AWS chain: AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY, an AWS_PROFILE, SSO, or AWS_BEARER_TOKEN_BEDROCK.
AWS_REGION=us-east-1

# Amazon Bedrock: reasoning for events no household rule covers.
# Needs model access to Claude enabled in the Bedrock console for this region.
BEDROCK_MODEL_ID=anthropic.claude-opus-5

# Amazon SNS: guardian notifications. Create a topic, subscribe the guardian's
# phone (SMS) or email to it, and put the topic ARN here. Unset = console log.
NEXUS_GUARDIAN_SNS_TOPIC_ARN=
